# =============================================================================
# .gitignore - Tells Git which files/folders to IGNORE (not track).
#
# WHY?
#   - Some files are auto-generated (no need to share them)
#   - Some files contain secrets (.env with passwords)
#   - Some files are huge (node_modules, virtual environments)
#
# HOW IT WORKS:
#   - Each line is a pattern. Files matching that pattern won't be committed.
#   - "*.py[cod]" means any .pyc, .pyo, or .pyd file
#   - "folder/" means ignore the entire folder
#   - "#" lines are comments
# =============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# --- Virtual Environment ---
venv/
env/
.venv/

# --- Django ---
db.sqlite3
*.sqlite3
media/
staticfiles/

# --- Environment / Secrets ---
.env                # Contains SECRET_KEY, DB passwords, API keys — NEVER commit this!

# --- IDE / Editor ---
.vscode/            # VS Code settings (personal to each developer)
.idea/              # PyCharm/IntelliJ settings
*.swp               # Vim swap files
*.swo               # Vim swap files

# --- Operating System ---
.DS_Store           # macOS folder metadata
Thumbs.db           # Windows image cache

# --- Testing ---
.coverage           # Coverage data file
htmlcov/            # HTML coverage report
.pytest_cache/      # Pytest's cache directory

# --- Node.js (if React is added later) ---
node_modules/       # JavaScript dependencies — like venv but for JS
package-lock.json   # Lockfile for npm

settings.json       # VS Code workspace settings (personal to each developer)

settings.json          # VS Code workspace settings (personal to each developer)
Pipfile.lock
Pipfile.lock
