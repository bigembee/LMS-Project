# =============================================================================
# .env.example - Template for environment variables.
#
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in the real values in .env
#   3. NEVER commit .env to git — it contains secrets!
#      (.gitignore already excludes it)
#
# WHY USE .env?
#   - Keeps passwords and secret keys OUT of your source code
#   - Different developers can have different settings (different DB passwords, etc.)
#   - Production server uses different values than your laptop
#   - python-decouple reads these values in settings.py via config("KEY_NAME")
# =============================================================================

# DEBUG=True shows detailed error pages in the browser. NEVER set True in production!
DEBUG=True

# SECRET_KEY is used by Django for cryptographic signing (sessions, tokens, etc.)
# Generate a real one: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Which domain names this Django site can serve. Prevents HTTP Host header attacks.
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# ENGINE: which database backend to use
#   django.db.backends.sqlite3     → SQLite (file-based, good for development)
#   django.db.backends.postgresql  → PostgreSQL (for production)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# --- Email ---
# EMAIL_BACKEND controls how Django sends emails
#   console.EmailBackend → prints emails to your terminal (for development)
#   smtp.EmailBackend    → actually sends real emails (for production)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
